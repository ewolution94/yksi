{
  "name": "yksi",
  "private": true,
  "version": "0.1.0",
  "description": "Our own colour-matching card game for the afternoon meeting, solo against bots or at a table with friends: match the colour or the number, call \"Yksi!\" with one card left.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/server.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:sim": "node --test tests/*.sim.mjs"
  },
  "devDependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.1"
  }
}
